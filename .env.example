NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/qm-portfolio
# Exact browser origin; verification and reset links use this origin.
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# Optional integrations
# OPENAI_API_KEY=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional SMTP delivery; set all five values to enable SMTP.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=portfolio@example.com

# Required only for the one-time `npm run seed:admin` command.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Local development image storage. Production must use S3.
ASSET_STORAGE_PROVIDER=local
UPLOAD_DIR=var/uploads
# Public API origin for generated asset URLs; required in production.
# PUBLIC_API_ORIGIN=http://localhost:3000

# Required only for npm run seed:demo and npm run seed:demo:clear.
# Must be an existing workspace whose slug starts with demo-test-.
# DEMO_TENANT_SLUG=demo-test-workspace

# Production S3 configuration; use the AWS default credential chain/instance role.
# ASSET_STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# S3_BUCKET=portfolio-assets
