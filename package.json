    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.18.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
